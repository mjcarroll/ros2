# Supplemental repos for the ci.ros2.org Windows compiler cache experiment.
#
# vcs import runs over ros2.repos first and this file second, both with
# --force, so this entry replaces the gz_cmake_vendor that ros2.repos pins.
#
# The branch points gz_cmake_vendor at gazebosim/gz-cmake
# mjcarroll/no-hardcoded-msvc-debug-format, which stops USE_GZ_RECOMMENDED_FLAGS
# from hardcoding /Zi and leaves the debug information format to CMake.  sccache
# cannot compile /Zi at all -- it fails with C1041 even though CMake passes /FS
# for the Ninja generator -- so without this the build does not merely miss the
# cache, it dies.  gz-cmake is installed by gz_cmake_vendor and found by
# gz_math_vendor and gz_utils_vendor through CMAKE_PREFIX_PATH, so fixing it
# here fixes all three.
#
# Temporary.  The real fix is gazebosim/gz-cmake#586; once that is released,
# gz_cmake_vendor bumps LIB_VCS_VER and this file goes away.
repositories:
  gazebo-release/gz_cmake_vendor:
    type: git
    url: https://github.com/gazebo-release/gz_cmake_vendor.git
    version: mjcarroll/test-z7
