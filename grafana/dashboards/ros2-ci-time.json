{
 "uid": "ros2-ci-time",
 "title": "Where the time goes",
 "description": "Phase and package timing.",
 "schemaVersion": 39,
 "version": 3,
 "timezone": "browser",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "tags": [
  "ros2",
  "ci"
 ],
 "panels": [
  {
   "type": "timeseries",
   "title": "Time per phase of each build (minutes)",
   "description": "Top-level sections of the job: the Docker image build and the run.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "last_over_time(ci_section_duration_seconds{ci_job=\"$job\",ci_kind=\"section\"}[$__interval]) / 60",
     "legendFormat": "{{ci_section}}",
     "instant": false,
     "range": true,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "barAlignment": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Inside the run (minutes)",
   "description": "Repository import, colcon build and colcon test, and the smaller setup steps.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "last_over_time(ci_section_duration_seconds{ci_job=\"$job\",ci_kind=\"subsection\"}[$__interval]) / 60",
     "legendFormat": "{{ci_section}}",
     "instant": false,
     "range": true,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "barAlignment": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 2
  },
  {
   "type": "bargauge",
   "title": "Average time per phase in range",
   "description": "Averaged over the builds in the range.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg by (ci_section)(last_over_time(ci_section_duration_seconds{ci_job=\"$job\"}[$__range]))",
     "legendFormat": "{{ci_section}}",
     "instant": true,
     "range": false,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 3
  },
  {
   "type": "bargauge",
   "title": "Slowest packages: colcon build",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(12, avg by (ci_package)(avg_over_time(ci_package_duration_seconds{ci_job=\"$job\",ci_phase=\"build\",ci_state=\"Finished\"}[$__range])))",
     "legendFormat": "{{ci_package}}",
     "instant": true,
     "range": false,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 4
  },
  {
   "type": "bargauge",
   "title": "Slowest packages: colcon test",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(12, avg by (ci_package)(avg_over_time(ci_package_duration_seconds{ci_job=\"$job\",ci_phase=\"test\",ci_state=\"Finished\"}[$__range])))",
     "legendFormat": "{{ci_package}}",
     "instant": true,
     "range": false,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 5
  },
  {
   "type": "table",
   "title": "Packages getting slower: last 7 days vs the 7 days before",
   "description": "Average duration over the last 7 days minus the 7 days before that, ignoring the time picker. Needs two weeks of builds.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(15, avg by (ci_package, ci_phase)(avg_over_time(ci_package_duration_seconds{ci_job=\"$job\",ci_state=\"Finished\"}[7d])) - avg by (ci_package, ci_phase)(avg_over_time(ci_package_duration_seconds{ci_job=\"$job\",ci_state=\"Finished\"}[7d] offset 7d)))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 10
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "ci_job": true,
       "ci_agent": true,
       "ci_build": true,
       "ci_trace_id": true,
       "ci_state": true,
       "ci_prev_build": true,
       "ci_status": true,
       "ci_first_failed_build": true
      },
      "renameByName": {
       "ci_build": "Build",
       "ci_trace_id": "Open trace",
       "ci_result": "Result",
       "ci_agent": "Agent",
       "ci_package": "Package",
       "ci_phase": "Phase",
       "ci_state": "State",
       "Value #A": "Seconds slower",
       "Value": "Seconds slower"
      },
      "indexByName": {
       "ci_package": 0,
       "ci_phase": 1
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Seconds slower",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "id": 6
  }
 ],
 "templating": {
  "list": [
   {
    "name": "job",
    "label": "Job",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(ci_build_duration_seconds, ci_job)",
     "refId": "job"
    },
    "current": {
     "text": "nightly_win_rel",
     "value": "nightly_win_rel"
    },
    "sort": 1
   }
  ]
 },
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "ros2"
   ],
   "title": "ROS 2 CI dashboards",
   "asDropdown": true,
   "includeVars": true,
   "keepTime": true
  }
 ]
}