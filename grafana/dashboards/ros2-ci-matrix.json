{
 "uid": "ros2-ci-matrix",
 "title": "All nightlies",
 "description": "Every nightly job side by side: scorecard, worst result per day, hours lost to hangs.",
 "schemaVersion": 39,
 "version": 3,
 "timezone": "utc",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "tags": [
  "ros2",
  "ci"
 ],
 "panels": [
  {
   "type": "table",
   "title": "Nightly scorecard",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "One row per job over the selected range. Green/yellow/orange/red columns are counts of builds by result; Aborted means the 600 minute limit was hit.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (ci_job)(last_over_time(ci_build_result[$__range]))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (ci_job)(last_over_time(ci_build_result{ci_result=\"SUCCESS\"}[$__range]))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (ci_job)(last_over_time(ci_build_result{ci_result=\"UNSTABLE\"}[$__range]))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (ci_job)(last_over_time(ci_build_result{ci_result=\"FAILURE\"}[$__range]))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "D"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (ci_job)(last_over_time(ci_build_result{ci_result=\"ABORTED\"}[$__range]))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "E"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "quantile by (ci_job)(0.5, last_over_time(ci_build_duration_seconds[$__range])) / 60",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "F"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (ci_job)(last_over_time(ci_build_duration_seconds{ci_result=\"ABORTED\"}[$__range])) / 3600",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "G"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 11
   },
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "ci_job",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true,
       "Time 7": true,
       "Time": true
      },
      "renameByName": {
       "ci_job": "Job",
       "Value #A": "Builds",
       "Value #B": "Green",
       "Value #C": "Unstable",
       "Value #D": "Failed",
       "Value #E": "Aborted",
       "Value #F": "Median min",
       "Value #G": "Hours lost to aborts"
      },
      "indexByName": {
       "ci_job": 0,
       "Value #A": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4,
       "Value #E": 5,
       "Value #F": 6,
       "Value #G": 7
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Job",
        "desc": false
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 1,
     "noValue": "0"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Aborted"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "transparent",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Failed"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "transparent",
           "value": null
          },
          {
           "color": "orange",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Green"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true
   },
   "id": 1
  },
  {
   "type": "status-history",
   "title": "Worst result per job per day",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Green = SUCCESS, yellow = UNSTABLE, orange = FAILURE, red = ABORTED. A day with several builds shows the worst one.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (ci_job)(last_over_time(ci_build_result{ci_result=\"ABORTED\"}[1d]) * 4 or last_over_time(ci_build_result{ci_result=\"FAILURE\"}[1d]) * 3 or last_over_time(ci_build_result{ci_result=\"UNSTABLE\"}[1d]) * 2 or last_over_time(ci_build_result{ci_result=\"SUCCESS\"}[1d]) * 1)",
     "legendFormat": "{{ci_job}}",
     "instant": false,
     "range": true,
     "format": "time_series",
     "refId": "A",
     "interval": "1d"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 12
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 85,
      "lineWidth": 1
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "SUCCESS",
         "color": "green",
         "index": 0
        },
        "2": {
         "text": "UNSTABLE",
         "color": "yellow",
         "index": 1
        },
        "3": {
         "text": "FAILURE",
         "color": "orange",
         "index": 2
        },
        "4": {
         "text": "ABORTED",
         "color": "red",
         "index": 3
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "rowHeight": 0.9,
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "id": 2
  },
  {
   "type": "bargauge",
   "title": "Hours lost to aborted builds, by job",
   "description": "Time spent in builds that ended at the 600 minute limit.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (ci_job)(last_over_time(ci_build_duration_seconds{ci_result=\"ABORTED\"}[$__range])) / 3600",
     "legendFormat": "{{ci_job}}",
     "instant": true,
     "range": false,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "Aborted builds per day, by job",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (ci_job)(count_over_time(ci_build_result{ci_result=\"ABORTED\"}[1d]))",
     "legendFormat": "{{ci_job}}",
     "instant": false,
     "range": true,
     "format": "time_series",
     "refId": "A",
     "interval": "1d"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 23,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "barAlignment": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 4
  },
  {
   "type": "table",
   "title": "Hangs and cut-off packages across all jobs - click \"Open trace\"",
   "description": "Packages still running when a build ended. A package that shows up in several jobs points at the package, not the platform.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max_over_time(ci_package_duration_seconds{ci_state=\"Unfinished\"}[$__range])",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 8
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "ci_job": true,
       "ci_state": true,
       "ci_prev_build": true,
       "ci_status": true,
       "ci_first_failed_build": true
      },
      "renameByName": {
       "ci_build": "Build",
       "ci_trace_id": "Open trace",
       "ci_result": "Result",
       "ci_agent": "Agent",
       "ci_package": "Package",
       "ci_phase": "Phase",
       "ci_state": "State",
       "ci_job": "Job",
       "Value #A": "Seconds",
       "Value": "Seconds"
      },
      "indexByName": {
       "ci_job": 0,
       "ci_build": 1,
       "ci_package": 2,
       "ci_phase": 3,
       "ci_agent": 4,
       "ci_trace_id": 5
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Build",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Open trace"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open build timeline",
          "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-30d%22%2C%22to%22%3A%22now%22%7D%7D%7D",
          "targetBlank": true
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true
   },
   "id": 5
  },
  {
   "type": "table",
   "title": "Most frequently failing tests across all jobs",
   "description": "Number of builds, over every job, in which the test failed.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(25, count by (ci_test_class, ci_test)(last_over_time(ci_test_failure[$__range])))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 10
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "ci_job": true,
       "ci_agent": true,
       "ci_build": true,
       "ci_trace_id": true,
       "ci_state": true,
       "ci_prev_build": true,
       "ci_status": true,
       "ci_first_failed_build": true
      },
      "renameByName": {
       "ci_test_class": "Suite",
       "ci_test": "Test",
       "Value #A": "Builds failed",
       "Value": "Builds failed"
      },
      "indexByName": {
       "ci_test_class": 0,
       "ci_test": 1
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Builds failed",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Build duration by job (hours)",
   "description": "Points at 10 hours are the aborted builds.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "last_over_time(ci_build_duration_seconds[$__interval]) / 3600",
     "legendFormat": "{{ci_job}} #{{ci_build}}",
     "instant": false,
     "range": true,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 50,
    "w": 24,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "custom": {
      "drawStyle": "points",
      "pointSize": 9,
      "showPoints": "always",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 7
  }
 ],
 "templating": {
  "list": []
 },
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "ros2"
   ],
   "title": "ROS 2 CI dashboards",
   "asDropdown": true,
   "includeVars": true,
   "keepTime": true
  }
 ]
}