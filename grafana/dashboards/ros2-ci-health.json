{
 "uid": "ros2-ci-health",
 "title": "CI health",
 "description": "Result mix, hung builds and agent-hours lost, test volume.",
 "schemaVersion": 39,
 "version": 3,
 "timezone": "utc",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "tags": [
  "ros2",
  "ci"
