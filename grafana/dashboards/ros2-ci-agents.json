{
 "uid": "ros2-ci-agents",
 "title": "Agents",
 "description": "Per-agent results and durations.",
 "schemaVersion": 39,
 "version": 3,
 "timezone": "utc",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "tags": [
  "ros2",
  "ci"
 ],
 "panels": [
  {
   "type": "bargauge",
   "title": "Bad build rate per agent (FAILURE or ABORTED)",
   "description": "Agents are re-imaged, so ids change over time; look for repeat offenders.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * count by (ci_agent)(last_over_time(ci_build_result{ci_job=\"$job\",ci_result=~\"ABORTED|FAILURE\"}[$__range])) / count by (ci_agent)(last_over_time(ci_build_result{ci_job=\"$job\"}[$__range]))",
     "legendFormat": "{{ci_agent}}",
     "instant": true,
     "range": false,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 1
  },
  {
   "type": "bargauge",
   "title": "Builds per agent",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (ci_agent)(last_over_time(ci_build_result{ci_job=\"$job\"}[$__range]))",
     "legendFormat": "{{ci_agent}}",
     "instant": true,
     "range": false,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 2
  },
  {
   "type": "bargauge",
   "title": "Average build duration per agent",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg by (ci_agent)(last_over_time(ci_build_duration_seconds{ci_job=\"$job\"}[$__range]))",
     "legendFormat": "{{ci_agent}}",
     "instant": true,
     "range": false,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 3
  },
  {
   "type": "table",
   "title": "Results per agent",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (ci_agent, ci_result)(last_over_time(ci_build_result{ci_job=\"$job\"}[$__range]))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 9
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "ci_job": true,
       "ci_build": true,
       "ci_trace_id": true,
       "ci_state": true,
       "ci_prev_build": true,
       "ci_status": true,
       "ci_first_failed_build": true
      },
      "renameByName": {
       "ci_build": "Build",
       "ci_trace_id": "Open trace",
       "ci_result": "Result",
       "ci_agent": "Agent",
       "ci_package": "Package",
       "ci_phase": "Phase",
       "ci_state": "State",
       "Value #A": "Builds",
       "Value": "Builds"
      },
      "indexByName": {
       "ci_agent": 0,
       "ci_result": 1
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Builds",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Build duration by agent (minutes)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "last_over_time(ci_build_duration_seconds{ci_job=\"$job\"}[$__interval]) / 60",
     "legendFormat": "{{ci_agent}} #{{ci_build}} {{ci_result}}",
     "instant": false,
     "range": true,
     "format": "time_series",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "custom": {
      "drawStyle": "points",
      "pointSize": 9,
      "showPoints": "always",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 5
  }
 ],
 "templating": {
  "list": [
   {
    "name": "job",
    "label": "Job",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(ci_build_duration_seconds, ci_job)",
     "refId": "job"
    },
    "current": {
     "text": "nightly_win_rel",
     "value": "nightly_win_rel"
    },
    "sort": 1
   }
  ]
 },
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "ros2"
   ],
   "title": "ROS 2 CI dashboards",
   "asDropdown": true,
   "includeVars": true,
   "keepTime": true
  }
 ]
}